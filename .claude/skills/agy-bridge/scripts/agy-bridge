#!/usr/bin/env python3
"""Entry point: put this file's own scripts/ folder on sys.path, then run the agy_bridge package next to it."""
import os
import sys

sys.dont_write_bytecode = True  # never leave __pycache__ inside an installed skill
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from agy_bridge.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
