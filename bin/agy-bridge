#!/usr/bin/env python3
"""Entry point: put the plugin root on sys.path from this file's own location, then run."""
import os
import sys

_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(_ROOT, "src"))

from agy_bridge.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
